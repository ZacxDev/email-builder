{
  "action": {
    "default_title": "Toil-Killer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "all_frames": true,
      "js": [
        "content.js"
      ],
      "match_about_blank": true,
      "matches": [
        "https://*.civit.ai/*",
        "https://civitai.com/*",
        "http://localhost:5186/*",
        "http://localhost:5187/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "description": "Toil-Killer walk runner for Civitai apps.",
  "host_permissions": [
    "https://*.civit.ai/*",
    "https://civitai.com/*",
    "http://localhost:5186/*",
    "<all_urls>",
    "https://toil-s3.zacx.dev/*"
  ],
  "icons": {
    "128": "icons/icon-128.png",
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png"
  },
  "manifest_version": 3,
  "name": "Toil-Killer",
  "permissions": [
    "scripting",
    "sidePanel",
    "tabs",
    "activeTab",
    "webNavigation",
    "downloads",
    "storage"
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "version": "0.7.10",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
